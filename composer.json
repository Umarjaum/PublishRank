{
  "name": "publishrank/seo",
  "type": "wordpress-plugin",
  "description": "Universal technical and News SEO plugin for WordPress publishers",
  "license": "GPL-2.0-or-later",
  "autoload": {
    "psr-4": {
      "PublishRankSEO\\": "src/"
    }
  },
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.0",
    "phpstan/phpstan": "^1.11"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "phpcs": "phpcs --standard=phpcs.xml.dist src publishrank.php uninstall.php",
    "phpstan": "phpstan analyse src --level=5",
    "smoke": "php tests/smoke.php",
    "test": "bash tools/test_standalone.sh"
  }
}
