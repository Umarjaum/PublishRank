<?xml version="1.0"?>
<ruleset name="PublishRank WordPress Coding Standards">
	<description>WordPress Core and Extra standards for PublishRank PHP code. PSR-4 class filenames remain in StudlyCaps to match Composer autoloading.</description>

	<rule ref="WordPress-Core" />
	<rule ref="WordPress-Extra" />
	<arg name="extensions" value="php" />
	<config name="ignore_warnings_on_exit" value="1" />

	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase">
		<exclude-pattern>*/src/*</exclude-pattern>
	</rule>
	<rule ref="WordPress.Files.FileName.InvalidClassFileName">
		<exclude-pattern>*/src/*</exclude-pattern>
	</rule>
</ruleset>
