msgstr ""
"تصدیقی فائل 64 KB سے بڑی ہے۔ اصل تصدیقی فائلیں صرف چند سو بائٹس کی ہوتی ہیں۔"

#: src/SEO/SiteConnections.php:456
msgid ""
"The file is not plain UTF-8 text. Upload the original verification file from"
" the search engine."
msgstr "فائل سادہ UTF-8 متن نہیں ہے۔ سرچ انجن کی اصل تصدیقی فائل اپ لوڈ کریں۔"

#: src/SEO/SiteConnections.php:459
msgid ""
"The file contains active code (PHP or script). Verification files are plain "
"text, so it was refused for safety."
msgstr ""
"فائل میں فعال کوڈ (PHP یا اسکرپٹ) موجود ہے۔ تصدیقی فائلیں سادہ متن ہوتی ہیں،"
" اس لیے حفاظتی وجوہات کی بنا پر اسے مسترد کر دیا گیا۔"

