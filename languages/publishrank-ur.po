msgstr "410 — مواد حذف کر دیا گیا (کوئی ہدف نہیں)"

#: src/Admin/RedirectsPage.php:114
msgid "451 — Unavailable for legal reasons (no target)"
msgstr "451 — قانونی وجوہات کی بنا پر دستیاب نہیں (کوئی ہدف نہیں)"

#: src/Admin/RedirectsPage.php:116
