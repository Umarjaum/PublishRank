#: src/Admin/SiteVerificationPage.php:197
msgid "That file was not found."
msgstr "یہ فائل نہیں ملی۔"

#: src/Admin/SiteVerificationPage.php:217
#, php-format
msgid "Live check could not reach your site: %s"
