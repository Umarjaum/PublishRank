msgstr "محفوظ ہو گیا۔ آپ کا لاگ اِن صفحہ اب %s ہے — اسے بک مارک کر لیں!"

#: src/Security/WPHideLogin.php:823
msgid "Move the WordPress login page to a private address and keep wp-login.php and wp-admin hidden from visitors."
msgstr "WordPress کے لاگ اِن صفحے کو ایک نجی پتے پر منتقل کریں اور wp-login.php اور wp-admin کو وزیٹرز سے چھپائے رکھیں۔"

#: src/Security/WPHideLogin.php:832
msgid "Hide Login is disabled by wp-config.php."
msgstr "wp-config.php کی وجہ سے لاگ اِن چھپائیں غیر فعال ہے۔"

#: src/Security/WPHideLogin.php:832
msgid "The constant PUBLISHRANK_DISABLE_HIDE_LOGIN is set to true, so the standard WordPress login (wp-login.php and wp-admin) works as normal. Remove that line from wp-config.php to use your private login address again."
msgstr "PUBLISHRANK_DISABLE_HIDE_LOGIN کنسٹنٹ true پر سیٹ ہے، اس لیے WordPress کا معیاری لاگ اِن (wp-login.php اور wp-admin) معمول کے مطابق کام کرتا ہے۔ اپنا نجی لاگ اِن پتا دوبارہ استعمال کرنے کے لیے wp-config.php سے وہ لائن ہٹا دیں۔"

#: src/Security/WPHideLogin.php:837
msgid "Hide Login is waiting for you."
msgstr "لاگ اِن چھپائیں آپ کی تصدیق کا منتظر ہے۔"

#: src/Security/WPHideLogin.php:837
#, php-format
msgid "Your sign-in page has not moved yet. When you save below, it moves to %s. Copy that address first."
msgstr "آپ کا سائن اِن صفحہ ابھی منتقل نہیں ہوا۔ جب آپ نیچے محفوظ کریں گے تو یہ %s پر منتقل ہو جائے گا۔ پہلے یہ پتا کاپی کر لیں۔"

#: src/Security/WPHideLogin.php:842
msgid "Hide Login is turned off."
msgstr "لاگ اِن چھپائیں بند ہے۔"

#: src/Security/WPHideLogin.php:842
msgid "The standard WordPress login (wp-login.php and wp-admin) works as normal. Your address below is saved but not in use."
msgstr "WordPress کا معیاری لاگ اِن (wp-login.php اور wp-admin) معمول کے مطابق کام کرتا ہے۔ نیچے دیا گیا پتا محفوظ ہے مگر استعمال میں نہیں۔"

#: src/Security/WPHideLogin.php:842
msgid "Turn it on under Features"
msgstr "اسے خصوصیات میں جا کر آن کریں"

#: src/Security/WPHideLogin.php:847
msgid "Your login page is now here:"
msgstr "آپ کا لاگ اِن صفحہ اب یہاں ہے:"

#: src/Security/WPHideLogin.php:847
msgid "Bookmark this address. Visitors who are not signed in can no longer open wp-login.php, wp-register.php or the wp-admin folder."
msgstr "اس پتے کو بک مارک کر لیں۔ جو وزیٹرز سائن اِن نہیں ہیں وہ اب wp-login.php، wp-register.php یا wp-admin فولڈر نہیں کھول سکتے۔"

#: src/Security/WPHideLogin.php:855
msgid "Login address"
msgstr "لاگ اِن پتا"

#: src/Security/WPHideLogin.php:855
msgid "Login URL"
msgstr "لاگ اِن URL"

#: src/Security/WPHideLogin.php:856
msgid "Your private login address"
msgstr "آپ کا نجی لاگ اِن پتا"

#: src/Security/WPHideLogin.php:861
msgid "Blocked visitors"
msgstr "روکے گئے وزیٹرز"

#: src/Security/WPHideLogin.php:861
msgid "Redirection URL"
msgstr "ری ڈائریکشن URL"

#: src/Security/WPHideLogin.php:862 src/Admin/SettingsPage.php:1194 src/Admin/OnboardingPage.php:610
msgid "Send blocked visitors to"
msgstr "روکے گئے وزیٹرز کو یہاں بھیجیں"

#: src/Security/WPHideLogin.php:864
msgid "Redirect URL when someone tries to access the wp-login.php page and the wp-admin directory while not logged in. Leave 404 to show your not-found page."
msgstr "جب کوئی لاگ اِن کیے بغیر wp-login.php صفحے یا wp-admin ڈائریکٹری تک پہنچنے کی کوشش کرے تو اسے اس URL پر بھیجا جائے گا۔ اپنا نہ ملنے والا صفحہ دکھانے کے لیے 404 رہنے دیں۔"

#: src/Security/WPHideLogin.php:867
msgid "What is protected"
msgstr "کیا محفوظ ہے"

#: src/Security/WPHideLogin.php:867
msgid "Active protections"
msgstr "فعال تحفظات"

#: src/Security/WPHideLogin.php:869
msgid "wp-login.php and wp-register.php are hidden"
msgstr "wp-login.php اور wp-register.php چھپے ہوئے ہیں"

#: src/Security/WPHideLogin.php:870
msgid "wp-admin redirects visitors who are not signed in"
msgstr "wp-admin ان وزیٹرز کو ری ڈائریکٹ کرتا ہے جو سائن اِن نہیں ہیں"

#: src/Security/WPHideLogin.php:871
msgid "wp-signup and wp-activate are blocked on single sites"
msgstr "سنگل سائٹس پر wp-signup اور wp-activate بلاک ہیں"

#: src/Security/WPHideLogin.php:872
msgid "Login links in emails and menus use your new address"
msgstr "ای میلز اور مینیوز میں لاگ اِن لنکس آپ کا نیا پتا استعمال کرتے ہیں"

#: src/Security/WPHideLogin.php:873
msgid "The Customizer is blocked for visitors who are not signed in"
msgstr "جو وزیٹرز سائن اِن نہیں ہیں ان کے لیے کسٹمائزر بلاک ہے"

#: src/Security/WPHideLogin.php:875
msgid "Hiding the login page is not a replacement for strong passwords and two-factor sign-in."
msgstr "لاگ اِن صفحہ چھپانا مضبوط پاس ورڈز اور ٹو فیکٹر سائن اِن کا متبادل نہیں ہے۔"

#: src/Security/WPHideLogin.php:878
msgid "Save login settings"
msgstr "لاگ اِن کی ترتیبات محفوظ کریں"

#: src/Security/WPHideLogin.php:990 src/Security/WPHideLogin.php:1000
msgid "PublishRank Hide Login: Please note, if you check the comment_registration option \"Users must be registered and logged in to comment\", the login link will not be hidden on the comment block."
msgstr "PublishRank لاگ اِن چھپائیں: براہِ کرم نوٹ کریں، اگر آپ comment_registration آپشن \"تبصرے کے لیے صارفین کا رجسٹر اور لاگ اِن ہونا ضروری ہے\" منتخب کریں تو تبصروں کے حصے میں لاگ اِن لنک چھپا نہیں رہے گا۔"

#: src/Security/WPHideLogin.php:1017 src/Security/WPHideLogin.php:1027
msgid "PublishRank Hide Login: Please note that the comment_registration option “Users must be registered and logged in to comment” is activated on your site, the connection link will not be hidden on the comments block."
msgstr "PublishRank لاگ اِن چھپائیں: براہِ کرم نوٹ کریں کہ آپ کی سائٹ پر comment_registration آپشن “تبصرے کے لیے صارفین کا رجسٹر اور لاگ اِن ہونا ضروری ہے” فعال ہے، اس لیے تبصروں کے حصے میں لاگ اِن لنک چھپا نہیں رہے گا۔"

#: src/Security/WPHideLogin.php:1075
msgid "This feature is not enabled."
msgstr "یہ خصوصیت فعال نہیں ہے۔"

