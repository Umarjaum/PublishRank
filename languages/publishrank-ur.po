msgstr "%1$s، آئٹم %2$d"

#: src/Admin/AdminAssets.php:95 src/SEO/AdvancedFeatures.php:355
#, php-format
msgid "Remove item %2$d from %1$s"
msgstr "%1$s سے آئٹم %2$d ہٹائیں"

#: src/Admin/AdminAssets.php:96
#, php-format
msgid "Added item %2$d to %1$s."
msgstr "%1$s میں آئٹم %2$d شامل کر دیا گیا۔"

#: src/Admin/AdminAssets.php:97
#, php-format
msgid "Removed item %2$d from %1$s."
msgstr "%1$s سے آئٹم %2$d ہٹا دیا گیا۔"

#: src/Admin/AdminAssets.php:98
#, php-format
msgid "No more than %2$d items can be added to %1$s."
msgstr "%1$s میں %2$d سے زیادہ آئٹمز شامل نہیں کیے جا سکتے۔"

#: src/Admin/AdminAssets.php:99 src/SEO/AdvancedFeatures.php:189
#, php-format
msgid "Current dimensions: %1$s × %2$s px (%3$s pixels)."
msgstr "موجودہ ابعاد: %1$s × %2$s px (%3$s پکسلز)۔"

#: src/Admin/AdminAssets.php:100
msgid ""
"Meets Google’s image-size guidance. A 16:9 landscape ratio is recommended, "
"not required."
msgstr ""
"Google کی تصویری سائز سے متعلق ہدایات پر پورا اترتی ہے۔ 16:9 کا افقی تناسب "
"تجویز کیا جاتا ہے، لیکن لازمی نہیں۔"

#: src/Admin/AdminAssets.php:101
msgid ""
"Meets Google’s image-size guidance and is close to the recommended 16:9 "
"ratio."
msgstr ""
"Google کی تصویری سائز سے متعلق ہدایات پر پورا اترتی ہے اور تجویز کردہ 16:9 "
"تناسب کے قریب ہے۔"

#: src/Admin/AdminAssets.php:102 src/SEO/AdvancedFeatures.php:195
msgid ""
"Below Google’s suggested size for large Discover images: at least 1200 px "
"wide and more than 300,000 total pixels."
msgstr ""
"Discover کی بڑی تصاویر کے لیے Google کے تجویز کردہ سائز سے کم ہے: کم از کم "
"1200 px چوڑی اور کل 300,000 سے زیادہ پکسلز۔"

#: src/Admin/AdminAssets.php:103 src/SEO/AdvancedFeatures.php:162
msgid "Choose an image to inspect its pixel dimensions."
msgstr "پکسل کے ابعاد دیکھنے کے لیے تصویر منتخب کریں۔"

#: src/Admin/AdminAssets.php:104
msgid ""
"This image is not in the WordPress Media Library. You can check its "
"dimensions, but choose or upload it there to create a resized copy."
msgstr ""
"یہ تصویر WordPress میڈیا لائبریری میں نہیں ہے۔ آپ اس کے ابعاد دیکھ سکتے ہیں،"
" لیکن اس کی چھوٹی نقل بنانے کے لیے اسے وہاں سے منتخب یا اپ لوڈ کریں۔"

#: src/Admin/AdminAssets.php:105
msgid "Checking image dimensions…"
msgstr "تصویر کے ابعاد معلوم کیے جا رہے ہیں…"

#: src/Admin/AdminAssets.php:106
msgid ""
"The image dimensions could not be read. Check the URL or choose a Media "
"Library image."
msgstr ""
"تصویر کے ابعاد پڑھے نہیں جا سکے۔ URL چیک کریں یا میڈیا لائبریری سے تصویر "
"منتخب کریں۔"

#: src/Admin/AdminAssets.php:107
msgid "The image could not be loaded to read its dimensions."
msgstr "تصویر کے ابعاد پڑھنے کے لیے اسے لوڈ نہیں کیا جا سکا۔"

#: src/Admin/AdminAssets.php:108 src/SEO/AdvancedFeatures.php:236
msgid ""
"WordPress will not upscale this image. Choose an original large enough for "
"the requested output; enlarging cannot restore image detail."
msgstr ""
"WordPress اس تصویر کو بڑا نہیں کرے گا۔ مطلوبہ آؤٹ پٹ کے لیے کافی بڑی اصل "
"تصویر منتخب کریں؛ بڑا کرنے سے تصویر کی تفصیل واپس نہیں آ سکتی۔"

#: src/Admin/AdminAssets.php:109 src/SEO/AdvancedFeatures.php:239
msgid ""
"This image is already at the requested size. Keep it selected; no resized "
"copy is needed."
msgstr ""
"یہ تصویر پہلے ہی مطلوبہ سائز کی ہے۔ اسے منتخب رکھیں؛ اس کی چھوٹی نقل بنانے "
"کی ضرورت نہیں۔"

#: src/Admin/AdminAssets.php:110
msgid "Enter a height before choosing an exact crop."
msgstr "عین مطابق کراپ منتخب کرنے سے پہلے اونچائی درج کریں۔"

#: src/Admin/AdminAssets.php:111
msgid "Enter a width and optional height from 1 to 6000 px."
msgstr "1 سے 6000 px تک چوڑائی اور اختیاری اونچائی درج کریں۔"

#: src/Admin/AdminAssets.php:112
msgid "Creating a resized copy…"
msgstr "چھوٹی نقل بنائی جا رہی ہے…"

#: src/Admin/AdminAssets.php:113
msgid "The resized copy could not be created. Try another size or image."
msgstr "چھوٹی نقل نہیں بنائی جا سکی۔ کوئی اور سائز یا تصویر آزمائیں۔"

#: src/Admin/AdminAssets.php:114
#, php-format
msgid ""
"A %1$s × %2$s px copy was created and selected. The original remains "
"unchanged."
msgstr ""
"%1$s × %2$s px کی نقل بنائی اور منتخب کر لی گئی۔ اصل تصویر میں کوئی تبدیلی "
"نہیں ہوئی۔"

#: src/Admin/AdminAssets.php:115
msgid "Preview of the selected social image"
msgstr "منتخب کردہ سوشل تصویر کا پیش منظر"

#: src/Admin/AdminAssets.php:184
msgid "You do not have permission to do this."
msgstr "آپ کو یہ کرنے کی اجازت نہیں ہے۔"

#: src/Admin/AnalyticsPage.php:20
msgid "Analytics"
