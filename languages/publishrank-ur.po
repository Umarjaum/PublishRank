#: src/Admin/CrawlOptimizationPage.php:267
msgid "Remove search feed links"
msgstr "تلاش کے فیڈ لنکس ہٹائیں"

#: src/Admin/CrawlOptimizationPage.php:268
msgid "Remove Atom / RDF and legacy feed links"
msgstr "Atom / RDF اور پرانے فیڈ لنکس ہٹائیں"

