msgid "Uploaded image"
msgstr "اپ لوڈ کی گئی تصویر"

#: src/Robots/RobotsTxt.php:802
msgid "Internal search"
msgstr "اندرونی تلاش"

#: src/Robots/RobotsTxt.php:803
msgid "Tracking URL"
msgstr "ٹریکنگ URL"

#: src/Robots/RobotsTxt.php:804
msgid "Admin area"
msgstr "ایڈمن ایریا"

#: src/SEO/AdvancedFeatures.php:49
