msgstr "اس سائٹ کا پرانا پاتھ یا URL"

#: src/Admin/RedirectsPage.php:104
msgid ""
"Use a path or a full URL on this site. External source URLs are rejected "
"because rules match this site’s paths only."
msgstr ""
"اس سائٹ کا پاتھ یا مکمل URL استعمال کریں۔ بیرونی ماخذ کے URLs مسترد کیے جاتے"
" ہیں کیونکہ قواعد صرف اسی سائٹ کے پاتھز پر لاگو ہوتے ہیں۔"

#: src/Admin/RedirectsPage.php:108
msgid "301 — Moved permanently"
msgstr "301 — مستقل طور پر منتقل"

#: src/Admin/RedirectsPage.php:109
msgid "302 — Found (temporary)"
msgstr "302 — ملا (عارضی)"

#: src/Admin/RedirectsPage.php:110
